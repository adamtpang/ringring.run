# Copy to .env.local and fill in. Never commit .env.local.
# Any group left empty runs that part of the pipeline in demo mode.

# Apify (Google Maps scrape). Console > Settings > API & Integrations
APIFY_TOKEN=

# Supabase (Postgres). Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Reserved for future client-side realtime. Not used yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM (xAI, OpenAI-compatible). console.x.ai
XAI_API_KEY=
LLM_MODEL=grok-4.7
# Fast model for chat and simulated call turns (default grok-4.20-0309-non-reasoning)
# LLM_CHAT_MODEL=

# ElevenLabs. ELEVENLABS_API_KEY alone turns on the in-browser voice
# interview (/businesses/<id>/interview). Set INTERVIEW_VOICE=off to keep
# the interview text-only. Phone deploy also needs ELEVENLABS_PHONE_NUMBER_ID
# and is not yet tested against the live API.
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
# INTERVIEW_VOICE=

# Weekly check-ins (Vercel Cron). Set CRON_SECRET in the Vercel project env;
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Without it the
# cron route returns 503 and scans nothing.
CRON_SECRET=
# CHECKIN_MONTHLY_BUDGET_USD=1.00   # hard cap on scheduled check-in spend

# Optional
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_STYLE=responses   # or chat, for /chat/completions providers
# LLM_API_KEY=              # overrides XAI_API_KEY for another provider
# LLM_REASONING_EFFORT=     # low, medium, high (models that support it)
# APIFY_MAX_REVIEWS=20
# APIFY_TIMEOUT_SECS=600
# FORCE_DEMO=1              # force fixture data, stub diagnoser, local store
# LOCAL_DB_PATH=.data/local-db.json
